<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Searendipity Recruitment Report{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.23/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .gradient-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="min-h-screen bg-base-300 text-base-content font-sans antialiased">
    <header class="navbar bg-base-100 shadow-md sticky top-0 z-50 px-6 border-b border-base-200">
        <div class="flex-1 items-center gap-3">
            <a href="index.html" class="flex items-center gap-2 text-2xl font-black tracking-tight text-primary hover:opacity-90">
                <span>🌊</span>
                <span>Searendipity</span>
            </a>
            <span class="badge badge-outline badge-sm text-xs font-mono">Report</span>
        </div>
        <div class="flex-none">
            <ul class="menu menu-horizontal px-1 gap-1">
                <li><a href="index.html" class="btn btn-sm btn-ghost">Overview</a></li>
            </ul>
        </div>
    </header>

    <main class="container mx-auto px-4 py-8 max-w-7xl">
        {% block content %}{% endblock %}
    </main>

    <footer class="footer footer-center p-6 bg-base-100 text-base-content/60 border-t border-base-200 text-sm mt-12">
        <aside>
            <p>Generated by <strong>Searendipity</strong> — The serendipitous NationStates recruitment and analytics suite.</p>
        </aside>
    </footer>
</body>
</html>
