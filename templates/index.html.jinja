{% extends "base.html.jinja" %}
{% block title %}Searendipity Campaign Overview{% endblock %}
{% block content %}
<div class="flex flex-col gap-6">
    <!-- Top Hero Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-base-100 p-6 rounded-2xl shadow-sm border border-base-200">
        <div>
            <h1 class="text-3xl font-black tracking-tight">Recruitment Performance Report</h1>
            <p class="text-base-content/70 mt-1">
                Campaign period: <span class="badge badge-primary badge-outline">{{ analytics.timeRange.start|renderdate }}</span> to <span class="badge badge-primary badge-outline">{{ analytics.timeRange.end|renderdate }}</span>
            </p>
        </div>
        <div class="flex items-center gap-2">
            <span class="badge badge-success gap-1.5 py-3 px-4 font-semibold">
                <span class="inline-block w-2 h-2 rounded-full bg-success-content animate-pulse"></span>
                Analytics Synced
            </span>
        </div>
    </div>

    <!-- KPI Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-200">
            <div class="stat-figure text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </div>
            <div class="stat-title text-xs font-bold uppercase tracking-wider text-base-content/60">Telegrams Sent</div>
            <div class="stat-value text-primary text-3xl font-black">{{ analytics.stats.delivered|displaynum }}</div>
            <div class="stat-desc text-xs text-base-content/50">Dispatched volume</div>
        </div>

        <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-200">
            <div class="stat-figure text-info">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
            </div>
            <div class="stat-title text-xs font-bold uppercase tracking-wider text-base-content/60">Telegrams Read</div>
            <div class="stat-value text-info text-3xl font-black">{{ analytics.stats.readCount|displaynum }}</div>
            <div class="stat-desc text-xs font-semibold text-info">{{ analytics.stats.readRate }} open rate</div>
        </div>

        <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-200">
            <div class="stat-figure text-success">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
            </div>
            <div class="stat-title text-xs font-bold uppercase tracking-wider text-base-content/60">Nations Recruited</div>
            <div class="stat-value text-success text-3xl font-black">{{ analytics.stats.recruitCount|displaynum }}</div>
            <div class="stat-desc text-xs font-semibold text-success">{{ analytics.stats.recruitRate }} conversion rate</div>
        </div>

        <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-200">
            <div class="stat-figure text-warning">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
            </div>
            <div class="stat-title text-xs font-bold uppercase tracking-wider text-base-content/60">Faithful Recruits</div>
            <div class="stat-value text-warning text-3xl font-black">{{ analytics.faithfulCount|displaynum }}</div>
            <div class="stat-desc text-xs font-semibold text-warning">{{ analytics.preserveRate }} retention rate</div>
        </div>

        <div class="stat bg-base-100 rounded-2xl shadow-sm border border-base-200">
            <div class="stat-figure text-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-8 h-8 stroke-current">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
            <div class="stat-title text-xs font-bold uppercase tracking-wider text-base-content/60">WA Faithful</div>
            <div class="stat-value text-secondary text-3xl font-black">{{ analytics.waFaithfulCount|displaynum }}</div>
            <div class="stat-desc text-xs font-semibold text-secondary">{{ analytics.waPreserveRate }} WA retention</div>
        </div>
    </div>

    <!-- Main Content Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left 2 Cols: Template Breakdown -->
        <div class="lg:col-span-2 flex flex-col gap-6">
            <div class="card bg-base-100 shadow-sm border border-base-200">
                <div class="card-body p-6">
                    <h2 class="card-title text-xl font-bold flex items-center justify-between">
                        <span>Campaign Template Breakdown</span>
                        <span class="text-xs font-normal text-base-content/60">{{ (telegrams|items)|length }} categories</span>
                    </h2>

                    <div class="flex flex-col gap-4 mt-4">
                        {% for category, tg in (telegrams|items) %}
                        <div class="p-5 rounded-xl bg-base-200/50 border border-base-200 hover:border-primary/50 transition-all flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                            <div class="flex flex-col gap-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-lg text-primary">{{ category }}</span>
                                    <span class="badge badge-sm badge-neutral">{{ tg.templates|length }} template(s)</span>
                                </div>
                                <div class="text-xs text-base-content/60">
                                    {{ tg.timeRange.start|renderdate }} — {{ tg.timeRange.end|renderdate }}
                                </div>
                                <div class="flex flex-wrap gap-3 mt-2 text-xs font-mono">
                                    <span><strong>Sent:</strong> {{ tg.stats.delivered|displaynum }}</span>
                                    <span>•</span>
                                    <span><strong>Read:</strong> {{ tg.stats.readCount|displaynum }} ({{ tg.stats.readRate }})</span>
                                    <span>•</span>
                                    <span><strong>Recruits:</strong> {{ tg.stats.recruitCount|displaynum }} ({{ tg.stats.recruitRate }})</span>
                                </div>
                            </div>
                            <div>
                                <a href="{{ category }}.html" class="btn btn-sm btn-primary">Drill Down &rarr;</a>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Competitor Destinations Table -->
            <div class="card bg-base-100 shadow-sm border border-base-200">
                <div class="card-body p-6">
                    <h2 class="card-title text-xl font-bold">Competitor Regions (Recruit Migration)</h2>
                    <p class="text-xs text-base-content/60">Regions where recruited nations subsequently migrated instead of remaining in the target region.</p>

                    <div class="overflow-x-auto mt-4">
                        <table class="table table-zebra table-sm">
                            <thead>
                                <tr class="text-xs uppercase text-base-content/60">
                                    <th class="w-12">#</th>
                                    <th>Destination Region</th>
                                    <th class="text-right">Nations Migrated</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for region, count in (analytics.traitor_destinations|sortbyhighest) %}
                                <tr>
                                    <td class="font-mono text-base-content/40">{{ loop.index }}</td>
                                    <td class="font-semibold">{{ region }}</td>
                                    <td class="text-right font-mono font-bold text-error">{{ count|displaynum }}</td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="3" class="text-center text-base-content/50 py-4">No migrations recorded. All recruits remained loyal!</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Col: Methods & Recruiters Breakdown -->
        <div class="flex flex-col gap-6">
            <!-- Methods Breakdown -->
            <div class="card bg-base-100 shadow-sm border border-base-200">
                <div class="card-body p-6">
                    <h3 class="card-title text-base font-bold uppercase tracking-wider text-base-content/70">Telegrams By Method</h3>
                    <div class="flex flex-col gap-3 mt-3">
                        {% for method in (methods|sortstatsbyhighest) %}
                        <div class="flex items-center justify-between p-3 rounded-lg bg-base-200/50">
                            <div>
                                <div class="font-bold text-sm">{{ method[0]|methodname }}</div>
                                <div class="text-xs text-base-content/60">{{ method[1].delivered|displaynum }} telegrams</div>
                            </div>
                            <span class="badge badge-outline badge-primary font-mono text-xs">{{ method[1].recruitRate }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Recruiter Top Leaderboard -->
            <div class="card bg-base-100 shadow-sm border border-base-200">
                <div class="card-body p-6">
                    <h3 class="card-title text-base font-bold uppercase tracking-wider text-base-content/70">Top Senders (Nations)</h3>
                    <div class="flex flex-col gap-3 mt-3">
                        {% for nation in (nations|sortstatstop) %}
                        <div class="flex items-center justify-between p-3 rounded-lg bg-base-200/50">
                            <div class="flex items-center gap-3">
                                <span class="font-mono text-xs text-base-content/40">0{{ loop.index }}</span>
                                <div>
                                    <div class="font-bold text-sm">{{ nation[0]|canonname }}</div>
                                    <div class="text-xs text-base-content/60">{{ nation[1].delivered|displaynum }} sent</div>
                                </div>
                            </div>
                            <span class="badge badge-success badge-sm font-mono">{{ nation[1].recruitCount|displaynum }} recruits</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
